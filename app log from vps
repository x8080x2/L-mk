import time
import sys
import requests
import dns.resolver
import dns.exception

# ----- CONFIG (edit on your VPS only) -----
TENANT_ID = "29775c6a-2d6e-42ef-a6ea-3e0a46793619"
CLIENT_ID = "34dc06b1-d91e-4408-b353-528722266c04"
CLIENT_SECRET = "REPLACE_WITH_YOUR_CLIENT_SECRET"
DOMAIN = "example.com"  # replace with the domain you want to verify
# Polling config
DNS_POLL_INTERVAL = 30  # seconds between authoritative DNS checks
MAX_POLL_MINUTES = 60   # give up after this many minutes
# -------------------------------------------

TOKEN_URL = f"https://login.microsoftonline.com/{TENANT_ID}/oauth2/v2.0/token"
GRAPH_BASE = "https://graph.microsoft.com/v1.0"

def get_access_token():
    data = {
        "grant_type": "client_credentials",
        "client_id": CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "scope": "https://graph.microsoft.com/.default"
    }
    r = requests.post(TOKEN_URL, data=data, timeout=15)
    r.raise_for_status()
    return r.json()["access_token"]

def create_domain(access_token, domain):
    url = f"{GRAPH_BASE}/domains"
    headers = {"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
    payload = {"id": domain}
    r = requests.post(url, json=payload, headers=headers, timeout=15)
    if r.status_code in (200,201,204):
        return r.json() if r.content else {}
    elif r.status_code == 409:
        print("Domain already exists in tenant (409). Continuing.")
        return {}
    else:
        print("Create domain failed:", r.status_code, r.text)
        r.raise_for_status()

def get_verification_records(access_token, domain):
    url = f"{GRAPH_BASE}/domains/{domain}/verificationDnsRecords"
    headers = {"Authorization": f"Bearer {access_token}"}
    r = requests.get(url, headers=headers, timeout=15)
    r.raise_for_status()
    return r.json().get("value", [])

def check_txt_authoritative(record_name, expected_value, domain):
    try:
        ns_answers = dns.resolver.resolve(domain, "NS")
        ns_hosts = [str(r.target).rstrip('.') for r in ns_answers]
    except Exception as e:
        print("Failed to get NS for domain:", e)
        return False, []

    found_values = []
    for ns in ns_hosts:
        try:
            # get an IP for the NS
            try:
                ns_ip = dns.resolver.resolve(ns, "A")[0].to_text()
            except Exception:
                ns_ip = dns.resolver.resolve(ns, "AAAA")[0].to_text()
        except Exception:
            ns_ip = None

        try:
            resolver = dns.resolver.Resolver(configure=False)
            if ns_ip:
                resolver.nameservers = [ns_ip]
            answers = resolver.resolve(record_name, "TXT")
            for a in answers:
                # dnspython may return bytes in a.strings or txt_strings property
                parts = []
                for s in a.strings:
                    parts.append(s.decode() if isinstance(s, (bytes, bytearray)) else str(s))
                txt = "".join(parts)
                found_values.append(txt)
        except dns.exception.DNSException:
            continue
        except Exception:
            continue

    norm = [v.strip().strip('"') for v in found_values]
    return (expected_value in norm), norm

def verify_domain_api(access_token, domain):
    url = f"{GRAPH_BASE}/domains/{domain}/verify"
    headers = {"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
    r = requests.post(url, headers=headers, json={}, timeout=15)
    return r

def main():
    if "REPLACE_WITH_YOUR_CLIENT_SECRET" in CLIENT_SECRET or "example.com" == DOMAIN:
        print("Edit the top of the script and set CLIENT_SECRET and DOMAIN.")
        sys.exit(1)

    print("Getting access token...")
    token = get_access_token()

    print("Creating domain object (if not exists)...")
    try:
        create_domain(token, DOMAIN)
    except Exception as e:
        print("Create domain error (continuing):", e)

    print("Requesting verification DNS records from Graph...")
    records = get_verification_records(token, DOMAIN)
    if not records:
        print("No verification records returned. Exiting.")
        sys.exit(1)

    txt_record = None
    for r in records:
        if r.get("recordType", "").upper() == "TXT":
            txt_record = r
            break
    if not txt_record:
        print("No TXT verification record provided by Graph; records:", records)
        sys.exit(1)

    record_name = txt_record.get("name") or DOMAIN
    if record_name == "@" or record_name == "":
        record_fqdn = DOMAIN
    elif record_name.endswith("."):
        record_fqdn = record_name.rstrip(".")
    elif record_name.endswith(DOMAIN):
        record_fqdn = record_name
    else:
        record_fqdn = f"{record_name}.{DOMAIN}"

    expected_value = txt_record.get("text") or txt_record.get("value") or txt_record.get("recordValue")
    if isinstance(expected_value, list):
        expected_value = expected_value[0]
    expected_value = expected_value.strip().strip('"')

    print(f"\nAdd this TXT record at your DNS provider:")
    print(f"Host: {record_name}")
    print(f"Value: {expected_value}\n")

    print("Polling authoritative nameservers for TXT record...")
    deadline = time.time() + MAX_POLL_MINUTES * 60
    while time.time() < deadline:
        ok, found = check_txt_authoritative(record_fqdn, expected_value, DOMAIN)
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Found values: {found}")
        if ok:
            print("Expected TXT found on authoritative nameservers. Calling Graph verify...")
            resp = verify_domain_api(token, DOMAIN)
            if resp.status_code in (200, 204):
                print("Domain verified successfully.")
                sys.exit(0)
            else:
                print("Graph verify response:", resp.status_code, resp.text)
        else:
            print("Expected TXT not found yet. Waiting", DNS_POLL_INTERVAL, "s...")
        time.sleep(DNS_POLL_INTERVAL)

    print("Timed out waiting for DNS propagation. Try again later.")
    sys.exit(2)

if __name__ == "__main__":
    main()
